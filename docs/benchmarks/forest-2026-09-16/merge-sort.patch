diff --git a/src/graphics/world_renderer.c b/src/graphics/world_renderer.c
--- a/src/graphics/world_renderer.c
+++ b/src/graphics/world_renderer.c
@@ -41,6 +41,7 @@
 
 static OcclusionBuffer occlusion;
 static ChunkCandidate candidates[CHUNKS_PER_AXIS * CHUNKS_PER_AXIS];
+static ChunkCandidate candidateScratch[CHUNKS_PER_AXIS * CHUNKS_PER_AXIS];
 static int candidateCount, hiddenCount;
