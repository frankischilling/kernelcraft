AlignAfterOpenBracket: Align
AlignOperands: Align
AlignTrailingComments:
  Kind: Always
  OverEmptyLines: 0
AllowShortFunctionsOnASingleLine: None
AlwaysBreakAfterReturnType: None
AlwaysBreakBeforeMultilineStrings: false
BreakBeforeBraces: Attach
ColumnLimit: 180
ConstructorInitializerIndentWidth: 2
IndentWidth: 2
InsertBraces: false
KeepEmptyLinesAtTheStartOfBlocks: false
KeepEmptyLinesAtEOF: false
MaxEmptyLinesToKeep: 1
# Blank lines after control-flow blocks are preserved, not inserted automatically.
# Keep function and type definitions separated by a blank line.
SeparateDefinitionBlocks: Always
PointerAlignment: Left
SpaceBeforeParens: ControlStatements
SpacesBeforeTrailingComments: 1
UseTab: Never
TabWidth: 2
LineEnding: DeriveLF
# GLEW must stay before GLFW/freeglut and headers that include them.
SortIncludes: Never
